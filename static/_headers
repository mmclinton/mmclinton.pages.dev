# Cloudflare Pages headers — https://developers.cloudflare.com/pages/configuration/headers/

# Content-hashed / static assets: cache hard.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/main.css
  Cache-Control: public, max-age=31536000, immutable
/katex.min.css
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable
/processed_images/*
  Cache-Control: public, max-age=31536000, immutable
# Safe only while every reference goes through get_url(cachebust=true).
/img/projects/*
  Cache-Control: public, max-age=31536000, immutable

# Everything else: security headers. The CSP script-src hashes are filled in by
# postbuild.mjs with the SHA-256 of each inline script (matching minified bytes).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; img-src 'self'; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' __SCRIPT_HASHES__
